# Random string, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app. Set it in production only; in development it is inferred from the request, so any port works.
BETTER_AUTH_URL=

# Neon connection string. Leave empty in development to use a local PGlite database in ./.pglite
DATABASE_URL=

# Optional social login. Each provider is enabled only when both values are set.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
